# Strezless Platform Environment Configuration
# Copy this file to .env.local and fill in your values

# Database Connection
# Example: postgresql://username:password@localhost:5432/strezless_db
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# NextAuth Configuration (for future authentication)
NEXTAUTH_SECRET="generate-a-secure-random-string-here"
NEXTAUTH_URL="http://localhost:3000"

# Optional: External API Keys (for future integrations)
# SPOTIFY_CLIENT_ID=""
# SPOTIFY_CLIENT_SECRET=""
# APPLE_MUSIC_KEY=""
